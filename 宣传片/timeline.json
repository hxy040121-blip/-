  "texts": [
    {"b": 9,     "until": 12.6, "style": "narr",  "text": "到达洋馆的过程，没有留下任何记忆。"},
    {"b": 13,    "until": 15.8, "style": "narr",  "text": "每个人都是从一件要紧的事当中被带走的。"},
    {"b": 25,    "until": 27.6, "style": "cap",   "text": "十五个席位。一号位于正北，按顺时针排列。"},
    {"b": 28,    "until": 31.6, "style": "cap",   "text": "别人的名字、来历、本事，要实际听见、看见才知道。"},
    {"b": 32.5,  "until": 35.8, "style": "small", "text": "那个声音听不出男女，没有情绪，从上方传来。"},
    {"b": 36.5,  "until": 39.8, "style": "small", "text": "谁都没见过这种字形，谁读都懂。"},
    {"b": 40.5,  "until": 47.6, "style": "side",  "text": "每人拥有正位身份。"},
    {"b": 43,    "until": 47.6, "style": "side2", "text": "身份卡背面，记载对应的逆位身份。"},
    {"b": 48.5,  "until": 51.8, "style": "cap",   "text": "可以公开、隐瞒、冒认身份。"},
    {"b": 52,    "until": 55.8, "style": "cap",   "text": "身份卡告知的是初始身份，不证明持有人此刻仍拥有该身份。"},
    {"b": 57,    "until": 59.8, "style": "cap",   "text": "主持人秘密指定一名受命者。"},
    {"b": 60.5,  "until": 63.9, "style": "cap", "y": 800, "text": "受命者须在二十四小时内造成死亡。"},
    {"b": 62.5,  "until": 63.9, "style": "capRed", "y": 880, "text": "逾期，将被公开身份并处死。"},
    {"b": 64.3,  "until": 66.2, "style": "bcast", "text": "由于盲视者的能力，全馆陷入黑暗。", "blip": true},
    {"b": 68.4,  "until": 71.8, "style": "bcast", "text": "由于典狱长的能力，一扇门被强行关闭并锁住。", "blip": true},
    {"b": 73,    "until": 75.9, "style": "bcast", "text": "调查时间一百二十分钟，于二十一时在穹顶议事厅开庭。", "blip": true},
    {"b": 78,    "until": 79.9, "style": "mid",   "text": "已锁的门从里面打开再关上，仍锁着。"},
    {"b": 80,    "until": 81.9, "style": "mid",   "text": "听见报时，只能证明这只钟正在按自己的读数敲响。"},
    {"b": 85,    "until": 87.8, "style": "cap",   "text": "主持人移走尸体，只有身体本身消失。"},
    {"b": 96.2,  "until": 98.5, "style": "bcast", "text": "辩论结束，开始投票。", "blip": true},
    {"b": 101,   "until": 103.8,"style": "cap",   "text": "票数，并不只由选票决定。"},
    {"b": 105.6, "until": 107.9,"style": "bcast", "text": "■■■不是■■一案的凶手。本场第一次误判。", "blip": true},
    {"b": 108.3, "until": 111.8,"style": "big", "y": 170, "text": "真凶逃过本次审判后，继续参加游戏。"},
    {"b": 112.2, "until": 115.8,"style": "cap",   "text": "愿望只给最后一个活着留在馆里的人，所以一切同盟都有期限。"},
    {"b": 116,   "until": 119.8,"style": "cap",   "text": "人人明白这一点，也明白别人同样明白。"},
    {"b": 120.6, "until": 123.8,"style": "cap",   "text": "正门门扇外侧，紧贴连续黑钻石封墙。"},
    {"b": 125,   "until": 127.8,"style": "cap",   "text": "仍存活、在馆的人只剩一名时，"},
    {"b": 128,   "until": 131.6,"style": "gold",  "text": "主持人实现其任何愿望。"}
  ],

  "hostLines": [
