    {"sec": "intro",       "b": 1,   "until": 4.6,  "style": "narr",  "text": "到达洋馆的过程，没有留下任何记忆。"},
    {"sec": "mansion",     "b": 1.2, "until": 3.85, "style": "cap",   "text": "没有太阳方向，也没有移动的日影。"},
    {"sec": "flips",       "b": 0.5, "until": 7.8,  "style": "cap",   "text": "可以公开、隐瞒、冒认身份。"},
    {"sec": "coins",       "b": 9.6, "until": 11.85,"style": "cap",   "text": "抢夺他人的金币，不受主持人惩罚。"},
