    {"sec": "investigate", "b": 2,   "until": 5.9,  "style": "mid",   "text": "已锁的门从里面打开再关上，仍锁着。"},
    {"sec": "escape",      "b": 0.3, "until": 3.9,  "style": "big",   "y": 170, "text": "真凶逃过本次审判后，继续参加游戏。"},
    {"sec": "names",       "b": 0.2, "until": 7.8,  "style": "cap",   "text": "愿望只给最后一个活着留在馆里的人，所以一切同盟都有期限。"},
    {"sec": "wish",        "b": 4,   "until": 7.6,  "style": "gold",  "text": "主持人实现其任何愿望。"}
